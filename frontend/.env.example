# NETRA Frontend Environment Variables
# Copy to frontend/.env and fill in deployed URLs

# Backend API URL (Render pe deploy hone ke baad ye URL milega)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Engine URL (Cloudflare Tunnel se milega — laptop pe engine chalne par)
VITE_ENGINE_URL=http://127.0.0.1:8001
